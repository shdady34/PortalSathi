{
  "manifest_version": 3,
  "name": "PortalSathi - Gov Site Assistant",
  "version": "1.0",
  "description": "Fixes session timeouts, compresses images, and decodes jargon on Indian government portals.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open PortalSathi"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}